BOT_TOKEN=
# nginx основного compose (он убирает префикс /api), опубликован на хосте
API_BASE_URL=http://localhost:88
# Тот же ключ, что в Bot__ApiKey у бэкенда (BOT_API_KEY в корневом .env)
BOT_API_KEY=
# Путь выдачи токена бота (необязательно)
AUTH_PATH=/api/auth/bot
# Прокси для Telegram, если он недоступен напрямую (необязательно), например http://127.0.0.1:10808
TELEGRAM_PROXY=
